def db_special_method(sql_statment, special_statment, inserts, location): # not yet properly tested
    try:
        with con:
            cur = con.execute(sql_statment, inserts)
            ret = getattr(cur, special_statment)() # makes the spectial function happen to the object in order to take out the info we need
            return ret
    except Exception as e:
        print(f" Error {e} at {location}")
        
def db_insert_into(sql_statment, inserts, location): # because lastrowid is a attibute not a method it doesn't use the ()
    try:
        with con: # REMEMBER TO ADD WITH CON
            cur = con.execute(sql_statment, inserts) # the question marks stop injections
            sel_id = cur.lastrowid # gets the id of new user WHICH IS ESSENTIAL
            return sel_id
    except Exception as e:
        print(f"{e} at {location}")
        
def db_statment(sql_statment, inserts, location): # go back and find these
    try:
        with con:
            cur = con.execute(sql_statment, inserts)
    except Exception as e:
        print(f" Error {e} at {location}")
