def log_in(usr_name: str, usr_password: str):
    global attempts, id_user, username
   
    if attempts > 2: # if they have more then 3 attempts it destorys the sign in/up and stops the log in
        MainScreen.destroy()
        while True: #locks the user until they properly close the program
            messagebox.showwarning("Problem with log in", "Locked out")

    row = db_special_method("SELECT password, User_ID FROM Users WHERE Users.username = ?", "fetchone", (usr_name, ), "log_in")
    if row == None: # if there is no row then the username was not found in the database
        messagebox.showwarning("Problem with log in", "Inputed username was not found")
        return

    id_user = row[1] # gets the id of the user

    if row[0] == usr_password: # if the entered pass word is equal to saved password, (row[0] is used as it is only used in one place)
        username = usr_name # very inefficent, but can't think of anything else rn, I think that we could just use usr_name 
        open_decision_tree(Credentials) # moves to the next page correctly
    else:
        attempts += 1
        lbl_tries.config(text=f"tries: {attempts}") # shows the user the new amount of attempts
       

