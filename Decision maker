def simplest_reader(): # TO-DO
    min_val = db_special_method("SELECT MIN(tail) FROM Factors WHERE Decision_ID = ?", "fetchone", (des_id,), "simplest_reader 1")[0] # the [0] is there because a tuple gets returned
   
    list_factors = db_special_method("SELECT head, tail, pro FROM Factors WHERE Decision_ID = ?", "fetchall", (des_id,), "simplest_reader 2")
   
    uncertiaty = 0
    total_points = 0
    for head, tail, pro_or_con in list_factors:
        uncertiaty += head - tail - 1 #does the head - tail - 1 for the sum of every factor
       
        points = head - min_val
       
        if pro_or_con == 0: # if the factor is a con
            total_points -= points
        else:
            total_points += points # the points awarded is for every integer that the head is above the minimim value

    if total_points > 0:
        lbl_stats.config(text=f"+{total_points} +/- {uncertiaty}") # shows the sum
    else:
        lbl_stats.config(text=f"{total_points} +/- {uncertiaty}") # shows the sum

